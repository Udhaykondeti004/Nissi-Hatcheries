// Cloudflare Pages project config (free plan). Build with `npm run build`, then deploy with
// `npm run deploy` (uploads dist/ to the nissi-hatcheries Pages project).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nissi-hatcheries",
  "compatibility_date": "2026-11-19",
  "pages_build_output_dir": "./dist"
}
